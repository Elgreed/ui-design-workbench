{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Elgreed/ui-design-workbench/schemas/ui-agent-job.schema.json",
  "title": "UI Design Workbench portable agent job",
  "type": "object",
  "required": ["type", "version", "provider", "kind", "artifactDir", "allowedWrites", "sourceChangeAllowed"],
  "properties": {
    "type": { "const": "ui-design-workbench-agent-job" },
    "version": { "enum": [1, 2, 3] },
    "provider": { "type": "string" },
    "kind": { "enum": ["expert", "proposal", "source-plan", "implementation"] },
    "artifactDir": { "type": "string" },
    "uiIrFile": { "type": "string" },
    "contextFile": { "type": "string" },
    "patchFile": { "type": "string" },
    "contextBudget": { "type": "object" },
    "scope": { "enum": ["all", "current"] },
    "screenIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "acceptedFindingIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "allowedWrites": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "projectRoot": { "type": "string" },
    "sourceTargets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sourceChangeAllowed": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "implementation" } }, "required": ["kind"] },
      "then": {
        "properties": { "sourceChangeAllowed": { "const": true }, "sourceTargets": { "minItems": 1 } },
        "required": ["projectRoot", "sourceTargets"]
      },
      "else": { "properties": { "sourceChangeAllowed": { "const": false } } }
    }
  ],
  "additionalProperties": true
}
