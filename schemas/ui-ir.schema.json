{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Elgreed/ui-design-workbench/schemas/ui-ir.schema.json",
  "title": "UI Design Workbench intermediate representation",
  "type": "object",
  "required": ["version", "project", "screens", "nodes"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "root": { "type": "string" } },
      "additionalProperties": true
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "root"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "root": { "type": "string", "minLength": 1 },
          "route": { "type": "string" },
          "fragment": { "type": "string" },
          "logicalView": { "type": "boolean" },
          "navigationFlowId": { "type": "string", "minLength": 1 },
          "navigationEntry": { "type": "boolean" },
          "platform": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/sourceRef" },
          "confidence": { "enum": ["exact", "high", "approximate", "unsupported"] },
          "viewport": { "$ref": "#/$defs/viewport" },
          "defaultScenarioId": { "type": "string" },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": { "id": { "type": "string", "minLength": 1 }, "fixtureRef": { "type": "string" } },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["container", "card", "text", "button", "input", "image", "icon", "spacer", "divider", "list", "custom"] },
          "confidence": { "enum": ["exact", "high", "approximate", "unsupported"] },
          "source": { "$ref": "#/$defs/sourceRef" },
          "action": { "$ref": "#/$defs/action" },
          "semantics": { "$ref": "#/$defs/semantics" },
          "provenance": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/propertyEvidence" }
          }
        },
        "additionalProperties": true
      }
    },
    "tokens": { "type": "object" },
    "fidelity": {
      "type": "object",
      "properties": {
        "schemaVersion": { "enum": ["0.3"] },
        "status": { "type": "string" },
        "sourceDerived": { "type": "boolean" },
        "adapters": { "type": "array", "items": { "type": "string" } },
        "unsupported": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "scenarioFixtures": { "type": "object" },
    "themes": {
      "type": "object",
      "required": ["defaultThemeId", "items"],
      "properties": {
        "defaultThemeId": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["light", "dark", "custom"] },
              "sourceRefs": { "type": "array", "items": { "type": "object" } },
              "tokenOverrides": { "type": "object" },
              "nodeOverrides": { "type": "object" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "baselineVersion": { "type": "string", "minLength": 1 },
        "activeVersion": { "type": "string", "minLength": 1 },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sourceRef": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" }
      },
      "additionalProperties": true
    },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "device": { "type": "string" },
        "frame": { "type": "boolean" },
        "background": {}
      },
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["navigate", "back", "set-node-state", "toggle-node-state", "toggle", "reset-state"]
        },
        "target": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "offState": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "navigate" } }, "required": ["type"] },
          "then": { "required": ["target"] }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["set-node-state", "toggle-node-state", "toggle"] } },
            "required": ["type"]
          },
          "then": { "required": ["target", "state"] }
        }
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "targetSize": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        },
        "targetSizeException": {
          "type": "object",
          "required": ["reason"],
          "properties": { "reason": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "viewport"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "viewport": { "oneOf": [{ "const": "current" }, { "$ref": "#/$defs/viewport" }] },
              "zoomLevels": {
                "type": "array",
                "items": { "type": "number", "minimum": 0.2, "maximum": 2 }
              }
            },
            "additionalProperties": true
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "kind": {
                "enum": ["screen-render", "zoom-reset", "overview-geometry", "menu-exclusivity", "layout-integrity", "accessibility-basics", "state-matrix", "navigation-flow", "contrast-focus"]
              },
              "entryScreenIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "propertyEvidence": {
      "type": "object",
      "required": ["id", "kind", "file", "line", "adapter", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "source" },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "expression": { "type": "string" },
        "adapter": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["exact", "high", "approximate", "unsupported"] }
      },
      "additionalProperties": false
    }
  }
}
