<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="360" Padding="24,16,40,32" Background="#FFF5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="title" Grid.Row="0" Text="Platform sample" FontFamily="Arial" FontSize="20" Foreground="#FF123456"/>
        <Border x:Name="card" Grid.Row="2" Width="240" HorizontalAlignment="Left" Padding="10,8,20,12" Background="#80336699">
            <TextBlock x:Name="nested" Text="Nested text" FontFamily="Arial" FontSize="14" Foreground="#FF000000"/>
        </Border>
        <Border x:Name="footer" Grid.Row="4" Width="240" HorizontalAlignment="Left" Background="#FF224466"/>
    </Grid>
</Border>
