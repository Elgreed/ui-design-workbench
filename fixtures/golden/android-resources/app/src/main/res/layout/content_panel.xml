<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center"
    android:padding="@dimen/content_padding">
    <TextView android:id="@+id/title" style="@style/TitleText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/screen_title" />
    <ImageView android:id="@+id/add_icon"
        android:layout_width="24dp" android:layout_height="24dp"
        android:src="@drawable/ic_add" android:scaleType="fitCenter"
        android:contentDescription="@string/add_project" />
</LinearLayout>
