{
  "version": 2,
  "profiles": {
    "material3": {
      "family": "android",
      "label": "Android · Material 3",
      "standardRefPrefixes": ["material3.", "project."],
      "minimumTarget": {"width": 48, "height": 48},
      "requiredInteractionStates": ["default", "pressed", "focused", "disabled"],
      "requirements": ["system-back", "edge-to-edge-insets", "dynamic-color-aware", "scalable-type"]
    },
    "apple-hig": {
      "family": "ios",
      "label": "iOS · Apple HIG",
      "standardRefPrefixes": ["apple.", "project."],
      "minimumTarget": {"width": 44, "height": 44},
      "requiredInteractionStates": ["default", "highlighted", "focused", "disabled"],
      "requirements": ["safe-area-insets", "dynamic-type", "system-back", "reduced-motion"]
    },
    "web-platform": {
      "family": "web",
      "label": "Web · semantic HTML, WCAG 2.2 AA, APG",
      "standardRefPrefixes": ["html.", "aria.", "project."],
      "minimumTarget": {"width": 24, "height": 24},
      "recommendedTouchTarget": {"width": 44, "height": 44},
      "requiredInteractionStates": ["default", "hover", "focus-visible", "active", "disabled"],
      "requirements": ["keyboard-complete", "focus-visible", "semantic-landmarks", "reflow-320-css-px"]
    },
    "windows-fluent": {
      "family": "windows",
      "label": "Windows · Fluent, WinUI and Windows accessibility",
      "standardRefPrefixes": ["windows.", "winui.", "project."],
      "minimumTarget": {"width": 40, "height": 40},
      "requiredInteractionStates": ["default", "pointer-over", "pressed", "focused", "disabled"],
      "requirements": ["keyboard-complete", "visible-focus", "narrator-uia", "text-scaling", "high-contrast", "resizable-window", "multi-input"],
      "referenceUrls": [
        "https://learn.microsoft.com/windows/apps/design/",
        "https://learn.microsoft.com/windows/apps/develop/input/guidelines-for-targeting",
        "https://learn.microsoft.com/windows/apps/develop/input/keyboard-interactions",
        "https://learn.microsoft.com/windows/apps/design/accessibility/"
      ]
    },
    "macos-hig": {
      "family": "macos",
      "label": "macOS · Apple HIG",
      "standardRefPrefixes": ["macos.", "apple.", "project."],
      "minimumTarget": {"width": 28, "height": 28},
      "documentedMinimumTarget": {"width": 20, "height": 20},
      "requiredInteractionStates": ["default", "pressed", "focused", "disabled", "inactive-window"],
      "requirements": ["menu-bar-commands", "keyboard-shortcuts", "full-keyboard-access", "voiceover", "resizable-window", "active-inactive-window", "reduced-motion", "increase-contrast"],
      "referenceUrls": [
        "https://developer.apple.com/design/human-interface-guidelines/designing-for-macos/",
        "https://developer.apple.com/design/human-interface-guidelines/accessibility",
        "https://developer.apple.com/design/human-interface-guidelines/focus-and-selection/"
      ]
    },
    "flutter-adaptive": {
      "family": "flutter",
      "label": "Flutter · Material, Cupertino and adaptive layout",
      "standardRefPrefixes": ["flutter.", "material3.", "cupertino.", "project."],
      "minimumTarget": {"width": 48, "height": 48},
      "requiredInteractionStates": ["default", "hovered", "focused", "pressed", "disabled"],
      "requirements": ["adaptive-layout", "platform-semantics", "scalable-text", "safe-area-insets", "keyboard-complete", "reduced-motion"],
      "referenceUrls": [
        "https://docs.flutter.dev/ui/adaptive-responsive",
        "https://docs.flutter.dev/ui/accessibility-and-internationalization/accessibility"
      ]
    }
  },
  "frameworkAdapters": {
    "android-compose": {"families": ["android"], "profiles": ["material3"]},
    "android-views": {"families": ["android"], "profiles": ["material3"]},
    "swiftui": {"families": ["ios"], "profiles": ["apple-hig"]},
    "uikit": {"families": ["ios"], "profiles": ["apple-hig"]},
    "web": {"families": ["web"], "profiles": ["web-platform"]},
    "react-web": {"families": ["web"], "profiles": ["web-platform"]},
    "windows-winui": {"families": ["windows"], "profiles": ["windows-fluent"]},
    "windows-wpf": {"families": ["windows"], "profiles": ["windows-fluent"]},
    "windows-xaml": {"families": ["windows"], "profiles": ["windows-fluent"]},
    "swiftui-macos": {"families": ["macos"], "profiles": ["macos-hig"]},
    "appkit": {"families": ["macos"], "profiles": ["macos-hig"]},
    "flutter": {"families": ["flutter"], "profiles": ["flutter-adaptive"]}
  }
}
